# === Microsoft Azure AD App Registratie ===
# Maak een app aan in Azure Portal: https://portal.azure.com > Azure Active Directory > App registrations
# Vereiste API permissions (Application type):
#   - Calendars.Read          (agenda lezen)
#   - Tasks.Read              (taken lezen)
#   - Mail.Send               (mail versturen)
#   - User.Read.All           (gebruiker opzoeken)

AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# === Outlook configuratie ===
# Het werk e-mailadres waar de briefing naartoe gestuurd wordt
OUTLOOK_EMAIL=jouw.naam@bedrijf.nl

# Optioneel: specifieke user ID (als het e-mailadres niet werkt als identifier)
# OUTLOOK_USER_ID=

# === Overig ===
# Tijdstip voor de briefing (wordt gebruikt door de scheduler, niet door het script zelf)
BRIEFING_SEND_TIME=07:00
